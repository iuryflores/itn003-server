# Use somente no backend. Não colocar credenciais no client.
# Também aceita URLs postgresql+psycopg2:// usadas pelo SQLAlchemy.
1RIGO_POSTGRES_CONNECTION_STRING=postgresql://usuario:senha@localhost:5432/banco_1rigo
2RIGO_POSTGRES_CONNECTION_STRING=postgresql://usuario:senha@localhost:5432/banco_2rigo

# Manter desativado enquanto as consultas são validadas no DBeaver.
LEGACY_QUERIES_APPROVED=false
